# Copy this file to .env (git ignores .env) and fill in your keys.
# Without a key, Bean still works: Talk with Bean uses its script and Bean speaks in the browser voice.

# Talk with Bean (AI chat). Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Bean's ElevenLabs voice. Key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=PKtsQbgKDa44YlyHnywy
# ELEVENLABS_MODEL=eleven_flash_v2_5
